<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.db1.poc</groupId>
    <version>0.4.0-SNAPSHOT</version>
    <artifactId>mensageria-outbox</artifactId>

    <name>Mensageria Outbox</name>
    <description>Lado produtor da entrega atômica de mensagens: envelope, outbox, relay, lease, publicação com confirms,
        retenção e métricas.
    </description>
    <packaging>pom</packaging>

    <properties>
        <!-- Piso Java 8: o release 8 vale para o código principal e para o de teste. -->
        <maven.compiler.release>8</maven.compiler.release>
        <!-- Fontes em UTF-8, independente da codificação padrão da plataforma (ex.: Cp1252 no Windows). -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Variantes com bytecode Java 8 do driver e do Logback; a raiz fixa as de Java 11. -->
        <mssql-jdbc.version>13.4.0.jre8</mssql-jdbc.version>
        <logback.version>1.3.16</logback.version>
        <!-- Versão com que a biblioteca é construída e testada; gerenciada aqui para prevalecer sobre a do
             spring-boot-dependencies importado pelos módulos mensageria-outbox-spring-boot*. -->
        <amqp-client.version>5.37.0</amqp-client.version>
        <extra-enforcer-rules.version>1.12.1</extra-enforcer-rules.version>
        <!-- Limites explícitos de heap e de memória direta dos testes de integração (R26). -->
        <failsafe.argLine>-Xmx256m -XX:MaxDirectMemorySize=64m</failsafe.argLine>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-failsafe-plugin.version>3.5.1</maven-failsafe-plugin.version>
    </properties>

    <modules>
        <module>core</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.rabbitmq</groupId>
                <artifactId>amqp-client</artifactId>
                <version>${amqp-client.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:-options</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <dependencies>
                    <dependency>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>extra-enforcer-rules</artifactId>
                        <version>1.8.0</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>enforce-bytecode</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <enforceBytecodeVersion>
                                    <maxJdkVersion>8</maxJdkVersion>
                                    <!-- Filas VarHandle do netty: só carregadas a partir do JDK 11 (PlatformDependent.hasVarHandle). -->
                                    <ignoreClasses>
                                        <ignoreClass>io.netty.util.internal.shaded.org.jctools.queues.varhandle.*
                                        </ignoreClass>
                                    </ignoreClasses>
                                </enforceBytecodeVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
<!--            <plugin>-->
<!--                <groupId>org.apache.maven.plugins</groupId>-->
<!--                <artifactId>maven-failsafe-plugin</artifactId>-->
<!--                <version>${maven-failsafe-plugin.version}</version>-->
<!--                <configuration>-->
<!--                    <argLine>${failsafe.argLine}</argLine>-->
<!--                    <includes>-->
<!--                        <include>**/*IT.java</include>-->
<!--                    </includes>-->
<!--                </configuration>-->
<!--                <executions>-->
<!--                    <execution>-->
<!--                        <goals>-->
<!--                            <goal>integration-test</goal>-->
<!--                            <goal>verify</goal>-->
<!--                        </goals>-->
<!--                    </execution>-->
<!--                </executions>-->
<!--            </plugin>-->
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>JFrog-Sisprime</id>
            <name>JFrog - Maven artifact</name>
            <url>https://artifactory.sisprimedobrasil.net:443/artifactory/dependencies-maven/</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>JFrog-Sisprime</id>
            <name>JFrog - Maven artifact</name>
            <url>https://artifactory.sisprimedobrasil.net:443/artifactory/dependencies-maven/</url>
            <layout>default</layout>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>
</project>
