@startuml
title Padrão Outbox (Assíncrono - At-Least-Once)
participant App
database "Base principal" as DB
queue "Fila" as fila

activate App
    App -> DB : Salvar dados principais da transação
    activate DB
        App -> DB : Salvar dados de outbox
        create control "Outbox Thread" as OutboxAsync
        App  --> OutboxAsync : Publica evento para listener
        ... Aguarda fechamento da transação ...
        alt Transação finalizada com sucesso
        DB --> App : Confirmação de gravação
        deactivate DB
        activate App
            App -->> OutboxAsync : Disparo dos listeners existentes (Envio de mensagem)
        activate App
    deactivate App
deactivate App
deactivate App
activate OutboxAsync
loop Envio de mensagem até confirmação
    break Numero de tentativas excedido
        OutboxAsync -> DB : Atualizar status de envio como falha
        create participant "Monitoramento" as monitor
        OutboxAsync -> monitor : Notificar falha de envio
        note left #FFAAAA
            Validar a necessidade de controle sobre tempo 
            e se a mensagem ainda poderá ser enviada 
            no futuro para evitar problemas de transação
        end note
    end
    OutboxAsync -> fila : Enviar dados para fila
    activate fila
    break Mensagem recebida e confirmada
        fila --> OutboxAsync : Confirmação de recebimento
        deactivate fila
    end
    OutboxAsync -> OutboxAsync : Contabilizar falha no envio
    deactivate fila
end
OutboxAsync -> DB : Atualizar status de envio
destroy OutboxAsync
end

@enduml